# Copier ce fichier vers .env.local et renseigner les vraies valeurs.
# Ne JAMAIS committer .env.local ni la clé service_role.

# Dashboard Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé secrète — utilisée uniquement côté serveur (Server Actions), jamais
# exposée au navigateur. Nécessaire pour créer/désactiver des gérants
# (prompt 12) et pour l'upload vers Supabase Storage si besoin.
SUPABASE_SERVICE_ROLE_KEY=
